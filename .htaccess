# ═══════════════════════════════════════════════
#  GetOnlineTool.com — .htaccess
# ═══════════════════════════════════════════════

Options -Indexes
Options -MultiViews

RewriteEngine On
RewriteBase /

# ── 1. WWW → non-WWW (301 permanent) ──────────
RewriteCond %{HTTP_HOST} ^www\.getonlinetool\.com [NC]
RewriteRule ^(.*)$ https://getonlinetool.com/$1 [R=301,L]

# ── 2. Force HTTPS ─────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── 3. Remove trailing slash (except root) ─────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── 4. Clean URLs — Static pages ───────────────
# /about-us → /about-us.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^about-us$             about-us.html             [L]

# /blog → /blog.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog$                 blog.html                 [L]

# /contact-us → /contact-us.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^contact-us$           contact-us.html           [L]

# /privacy-policy → /privacy-policy.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^privacy-policy$       privacy-policy.html       [L]

# /terms-and-conditions → /terms-of-services.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^terms-and-conditions$ terms-of-services.html    [L]

# ── 5. Clean URLs — Tool pages ─────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tool/([a-z0-9-]+)$   tool/$1.html              [L]

# ── 6. Security headers ────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── 7. Gzip compression ────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
</IfModule>

# ── 8. Browser caching ─────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp            "access plus 6 months"
    ExpiresByType image/png             "access plus 6 months"
    ExpiresByType image/jpg             "access plus 6 months"
    ExpiresByType image/jpeg            "access plus 6 months"
    ExpiresByType text/html             "access plus 1 hour"
</IfModule>

# ── 9. Block PHP execution ─────────────────────
<FilesMatch "\.(php|phtml|php3|php5|php7|php8|phar|inc)$">
    Require all denied
</FilesMatch>

# ── 10. Custom error pages ─────────────────────
ErrorDocument 404 /index.html
